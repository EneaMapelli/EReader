# Flutter / Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub/
.pub-cache/
build/
coverage/
*.iml
.idea/
.vscode/
# Platform-generated local files
android/.gradle/
android/local.properties
android/key.properties
android/**/key.properties
android/captures/
windows/flutter/ephemeral/
# Local sensitive data
.env
.env.*
*.jks
*.keystore

# Windows local test runner: full stdout/stderr never enters Git
.local-test-results/
# Generated test results under test-results/ are intentionally tracked,
# after filtering. Do not ignore test-results/ globally.

example/
# User-owned EPUB/PDF evaluation corpus: local only, never commit.
/example/

# Local unsigned Windows portable Release ZIPs and native staging
.local-windows-build/

# Raw diagnostics MUST stay on the local machine. Never commit test
# console output, Flutter crash dumps, generated command wrappers or
# process exit-code files; they may contain OS usernames / private paths.
*.log
/test-results/runs/**/*.cmd
/test-results/runs/**/*.exit-code
/test-results/runs/latest-analyze.txt
/test-results/runs/latest-test-run.txt
